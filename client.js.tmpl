          id: 'dsh-video-wallpaper',
          order: -100,
        }, Wallpaper));
        ctx.slots.inject('plugins.row.config', () => ctx.slots.register({
          name: 'plugins.row.config',
          key: '@cekerel/dsh-video-wallpaper#dsh-video-wallpaper',
        }, ConfigPage));
      },
    };
  },
});
